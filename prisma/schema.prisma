generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


// ─── Enums ────────────────────────────────────────────────

enum AgentStatus {
  ACTIVE
  INACTIVE
  ERROR
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PolicyStatus {
  ACTIVE
  DISABLED
}

enum AuditAction {
  CREATED
  UPDATED
  DELETED
  APPROVED
  REJECTED
  TRIGGERED
}

// ─── Core Models ──────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  password      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  agents        Agent[]
  policies      Policy[]
  approvals     Approval[]
  auditLogs     AuditLog[]
  apiKeys       ApiKey[]
}

model Agent {
  id            String       @id @default(cuid())
  name          String
  description   String?
  status        AgentStatus  @default(ACTIVE)
  riskLevel     RiskLevel    @default(LOW)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId        String
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)

  policies      Policy[]
  approvals     Approval[]
  auditLogs     AuditLog[]
  interactions Interaction[]

  @@index([userId])
}

model Policy {
  id            String       @id @default(cuid())
  name          String
  description   String?
  rules         Json
  status        PolicyStatus @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId        String
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentId       String?
  agent         Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  approvals     Approval[]
  auditLogs     AuditLog[]

  @@index([userId])
  @@index([agentId])
}

model Approval {
  id            String         @id @default(cuid())
  status        ApprovalStatus @default(PENDING)
  reason        String?
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId        String
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentId       String?
  agent         Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  policyId      String?
  policy        Policy? @relation(fields: [policyId], references: [id], onDelete: SetNull)

  auditLogs     AuditLog[]

  @@index([userId])
  @@index([agentId])
  @@index([policyId])
}

model AuditLog {
  id            String      @id @default(cuid())
  action        AuditAction
  resourceType  String
  resourceId    String?
  details       Json?
  createdAt     DateTime @default(now())

  userId        String?
  user          User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentId       String?
  agent         Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  policyId      String?
  policy        Policy? @relation(fields: [policyId], references: [id], onDelete: SetNull)

  approvalId    String?
  approval      Approval? @relation(fields: [approvalId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([agentId])
  @@index([policyId])
  @@index([approvalId])
}

model ApiKey {
  id            String   @id @default(cuid())
  name          String
  keyHash       String   @unique
  keyPrefix     String
  isActive      Boolean  @default(true)
  lastUsedAt    DateTime?
  createdAt     DateTime @default(now())

  userId        String
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([keyHash])
  @@index([userId])
}

model Interaction {
  id            String   @id @default(cuid())
  prompt        String   @db.Text
  response      String   @db.Text @default("")
  model         String   @default("unknown")
  tokensUsed    Int      @default(0)
  riskScore     Int      @default(0)
  flagged       Boolean  @default(false)
  flagReason    String?
  metadata      Json?
  createdAt     DateTime @default(now())

  agentId       String
  agent         Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([flagged])
  @@index([createdAt])
}
